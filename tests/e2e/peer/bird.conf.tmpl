router id 192.0.2.2;
protocol device { scan time 10; }
protocol kernel {
  ipv4 { export all; };
}
protocol kernel kernel6 {
  ipv6 { export all; };
}
protocol static peerprefix {
  ipv4;
  route 185.121.170.0/24 via "eth0";
  route 198.51.100.0/24 via "eth0";
}
protocol static peerprefix6 {
  ipv6;
  route 2001:6464:1::/48 via "eth0";
}
protocol bgp to_router {
  local PEER_IP_PLACEHOLDER as 65002;
  neighbor ROUTER_IP_PLACEHOLDER as 65001;
  ipv4 { import all; export all; };
}
protocol bgp to_router6 {
  local PEER_IP6_PLACEHOLDER as 65002;
  neighbor ROUTER_IP6_PLACEHOLDER as 65001;
  ipv6 { import all; export all; };
}
